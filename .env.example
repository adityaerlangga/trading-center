# Paper desk. Optional read-only keys fetch your real taker fee.
# Enable Spot read, never enable withdrawal or trading on these keys.
PAPER_AUTOSTART=1
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# BINANCE_BNB_FEE=1

# Live desk — full Spot trading keys. Never commit real values.
# BINANCE_API_KEY_REAL=
# BINANCE_API_SECRET_REAL=
LIVE_BUDGET_USDT=100
LIVE_AUTOSTART=1
# Live copies the best recent paper-league strategy when flat (ensemble).

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=trading_center

# HTTP Basic Auth for production web UI (required in docker-compose).
# DESK_AUTH_USER=
# DESK_AUTH_PASSWORD=

# Docker Compose MySQL root (production only).
# MYSQL_ROOT_PASSWORD=
